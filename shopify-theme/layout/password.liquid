<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <title>{{ shop.name }}</title>
    {%- unless settings.type_heading.system? -%}
      {{ settings.type_heading | font_face: font_display: 'swap' }}
    {%- endunless -%}
    {%- unless settings.type_body.system? -%}
      {{ settings.type_body | font_face: font_display: 'swap' }}
    {%- endunless -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% render 'css-variables' %}
    {{ content_for_header }}
  </head>
  <body>
    <main id="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
