<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} — {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- unless settings.type_heading.system? -%}
      {{ settings.type_heading | font_face: font_display: 'swap' }}
    {%- endunless -%}
    {%- unless settings.type_body.system? -%}
      {{ settings.type_body | font_face: font_display: 'swap' }}
    {%- endunless -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% render 'css-variables' %}
    {{ content_for_header }}
  </head>
  <body data-currency="{{ cart.currency.iso_code }}">
    <a class="skip" href="#main">Skip to content</a>
    {% sections 'header-group' %}
    <main id="main">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
