<section class="band" id="categories">
  <div class="shell">
    <div class="band__head">
      <h2>{{ section.settings.heading }}</h2>
      <p class="muted">{{ section.settings.text }}</p>
    </div>
    <div class="cats">
      {% for block in section.blocks %}
        <a class="cat" href="{{ block.settings.url | default: '/collections/all' }}" {{ block.shopify_attributes }}>
          <span class="kicker">{{ block.settings.index }}</span>
          <strong>{{ block.settings.title }}</strong>
          <span>{{ block.settings.text }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you can buy" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Six shelves. Add only stock you actually have, with your own photos and prices." },
    {
      "type": "paragraph",
      "content": "Before you open the store, create collections with these handles: mobiles, audio, wearables, accessories, computing, software."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "index", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Mobiles" },
        { "type": "text", "id": "text", "label": "Text", "default": "Phones and tablets" },
        { "type": "text", "id": "url", "label": "Link", "default": "/collections/all" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Categories",
      "blocks": [
        { "type": "category", "settings": { "index": "01", "title": "Mobiles", "text": "Phones and tablets", "url": "/collections/mobiles" } },
        { "type": "category", "settings": { "index": "02", "title": "Audio", "text": "Buds, headphones, speakers", "url": "/collections/audio" } },
        { "type": "category", "settings": { "index": "03", "title": "Wearables", "text": "Watches and bands", "url": "/collections/wearables" } },
        { "type": "category", "settings": { "index": "04", "title": "Accessories", "text": "Chargers, cables, mounts", "url": "/collections/accessories" } },
        { "type": "category", "settings": { "index": "05", "title": "Computing", "text": "Hubs, keyboards, storage", "url": "/collections/computing" } },
        { "type": "category", "settings": { "index": "06", "title": "Software", "text": "Licenses you are allowed to resell", "url": "/collections/software" } }
      ]
    }
  ]
}
{% endschema %}
