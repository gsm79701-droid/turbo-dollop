<section class="band">
  <div class="shell">
    <div class="band__head">
      <div>
        <h1>{{ collection.title }}</h1>
        {% if collection.description != blank %}
          <div class="rte muted">{{ collection.description }}</div>
        {% endif %}
      </div>
      <form class="sort" method="get" data-sort>
        <label>
          <span class="visually-hidden">Sort</span>
          <select name="sort_by">
            {% for option in collection.sort_options %}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
            {% endfor %}
          </select>
        </label>
      </form>
    </div>
    {% paginate collection.products by 12 %}
      {% if collection.products_count == 0 %}
        <p class="muted">Nothing is listed here yet.</p>
      {% else %}
        <div class="grid">
          {% for product in collection.products %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
      {% endif %}
      {% if paginate.pages > 1 %}
        <nav class="pager" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
