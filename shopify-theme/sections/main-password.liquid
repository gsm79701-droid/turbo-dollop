<section class="gate">
  <div class="shell gate__card">
    <p class="kicker">Opening soon</p>
    <h1>{{ shop.name }}</h1>
    <p class="lede">{{ section.settings.text }}</p>
    {% form 'customer', class: 'news__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="gate-email">Email</label>
      <input id="gate-email" type="email" name="contact[email]" required autocomplete="email" placeholder="you@email.com">
      <button class="button" type="submit">Notify me</button>
      {% if form.posted_successfully? %}
        <p class="form-note" role="status">You are on the list.</p>
      {% endif %}
    {% endform %}
    <details class="gate__owner">
      <summary>Store owner</summary>
      {% form 'storefront_password' %}
        <label class="field">
          <span>Password</span>
          <input type="password" name="password" autocomplete="current-password">
        </label>
        <button class="button button--ghost" type="submit">Enter</button>
        {{ form.errors | default_errors }}
      {% endform %}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Opening soon",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Phones, gadgets, and licensed software. The store opens when real stock, photos, and prices are on the shelf."
    }
  ]
}
{% endschema %}
