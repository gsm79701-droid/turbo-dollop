{%- liquid
  assign shelf = section.settings.collection
-%}
{% if shelf != blank and shelf.products_count > 0 %}
  <section class="band">
    <div class="shell">
      <div class="band__head">
        <h2>{{ section.settings.heading | default: shelf.title }}</h2>
        <a href="{{ shelf.url }}">View all</a>
      </div>
      <div class="grid">
        {% for product in shelf.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    </div>
  </section>
{% elsif request.design_mode %}
  <section class="band">
    <div class="shell">
      <p class="muted">Choose a collection that already has products. This block stays hidden on the live store until then.</p>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "In stock now" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
