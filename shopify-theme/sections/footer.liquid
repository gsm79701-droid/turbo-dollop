<footer class="site-footer">
  <div class="shell footer__grid">
    <div>
      <p class="logo">{{ shop.name }}</p>
      <p class="muted">{{ section.settings.note }}</p>
    </div>
    <div>
      <p class="kicker">Shop</p>
      {% render 'nav-links', menu: section.settings.menu %}
    </div>
    <div>
      <p class="kicker">Policies</p>
      <ul class="nav__list">
        {% if shop.shipping_policy %}<li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>{% endif %}
        {% if shop.refund_policy %}<li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>{% endif %}
        {% if shop.privacy_policy %}<li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>{% endif %}
        {% if shop.terms_of_service %}<li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>{% endif %}
      </ul>
    </div>
  </div>
  <div class="shell footer__bar">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    <p>Payments processed by Shopify. We pack physical stock ourselves.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Mobiles, gadgets, and software licenses we are allowed to sell. Every physical order is packed against the order sheet before it ships."
    }
  ]
}
{% endschema %}
