<section class="hero">
  <div class="shell hero__grid">
    <div>
      <p class="kicker">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="lede">{{ section.settings.text }}</p>
      <div class="hero__actions">
        {% if section.settings.primary_label != blank %}
          <a class="button" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
          <a class="button button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
    </div>
    <aside class="plate" aria-label="What we sell">
      <p class="kicker">On the shelf</p>
      <ol class="plate__list">
        <li><span>01</span> Mobiles and tablets</li>
        <li><span>02</span> Audio</li>
        <li><span>03</span> Wearables</li>
        <li><span>04</span> Chargers, cables, mounts</li>
        <li><span>05</span> Computing gear</li>
        <li><span>06</span> Software licenses we can legally sell</li>
      </ol>
      <p class="plate__foot">Stolen devices and cracked software are not listed.</p>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gadget store" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Phones, gadgets, and licensed software." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "You order online. We check the item, pack it, and hand the parcel to the courier. Digital licenses ship only when we hold the right to sell them." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Browse everything" },
    { "type": "text", "id": "primary_link", "label": "Primary link", "default": "/collections/all" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Jump to categories" },
    { "type": "text", "id": "secondary_link", "label": "Secondary link", "default": "#categories" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
